{
	"name": "cogni-test",
	"private": true,
	"version": "0.9.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright install && playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"init-db": "npx drizzle-kit push --force",
		"start": "npx drizzle-kit push --force && node index.js",
		"init-db-dev": "cross-env DATABASE_URL=file:sqlite.db npx drizzle-kit push --force",
		"clear-db-dev": "rm -f sqlite.db sqlite.db-shm sqlite.db-wal && npm run init-db-dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@libsql/client": "^0.17.3",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-plugin-mkcert": "^2.1.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@fontsource/comic-neue": "^5.3.0",
		"@fontsource/fira-code": "^5.3.0",
		"@fontsource/roboto": "^5.3.0",
		"@types/web-push": "^3.6.4",
		"chart.js": "^4.5.1",
		"chartjs-plugin-annotation": "^3.1.0",
		"dotenv": "^17.4.2",
		"localforage": "^1.10.0",
		"onnxruntime-node": "^1.29.0",
		"short-uuid": "^6.0.3",
		"uuid": "^14.0.2",
		"web-push": "^3.6.7",
		"xlsx": "^0.18.5"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"onnxruntime-node@1.29.0": true
	}
}
